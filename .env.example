# Copy to .env and fill in. The SEC requires a descriptive User-Agent with contact info.
# Format: "First Last your.email@example.com"
SEC_USER_AGENT="Your Name your.email@example.com"

# Free key from console.groq.com (API Keys). Never commit the real .env.
GROQ_API_KEY=
# Optional: override the model (default openai/gpt-oss-120b)
# LLM_MODEL=openai/gpt-oss-120b
